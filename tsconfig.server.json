{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "outDir": "dist/server",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@pages/*": ["./src/pages/*"],
      "@store/*": ["./src/store/*"]
    }
  },
  "include": [
    "src/server/**/*", 
    "src/shared/**/*",
    "src/config/**/*"
  ],
  "exclude": [
    "src/server/**/*.test.ts", 
    "src/client/**/*"
  ],
  "ignores": [
    "dist/**",
    "coverage/**",
    "node_modules/**"
  ],
  "plugins": [
    "@tailwindcss/typography",
    "@tailwindcss/forms"
  ]
}
